# Copy this file when you point a frontend at the live scores.
# Paths are relative to API_BASE_URL. Change the host if the frontend is on another machine.

API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=*

# false keeps the OpenCV window closed. run.bat is unchanged and still opens it.
API_VISUALIZE=true

ENDPOINT_INDEX=/
ENDPOINT_HEALTH=/health
ENDPOINT_LIVE=/live
ENDPOINT_DECEPTION=/deception
ENDPOINT_EMOTION=/emotion
